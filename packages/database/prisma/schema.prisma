generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id               String           @id @default(cuid())
  name             String
  email            String           @unique
  grade            Int
  password         String
  schoolName       String?
  hasCodingExp     Boolean          @default(false)
  codingExpLevel   String?
  favoriteInterest String?
  learningGoal     String?
  isOnboarded      Boolean          @default(false)
  games            Game[]
  progress         GameProgress[]
  sessions         StudentSession[]
  tutorSession     TutorSession?
  learningModules  LearningModule[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt @default(now())
}

model StudentSession {
  id         String   @id @default(cuid())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  tokenHash  String   @unique
  deviceInfo String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([studentId])
  @@index([tokenHash])
}

model Game {
  id          String         @id @default(cuid())
  title       String
  category    String // "logic" | "loops" | "conditionals" | "debugging" | "algorithms"
  difficulty  Int
  description String
  questions   Json?
  studentId   String?
  student     Student?       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  progress    GameProgress[]

  @@index([studentId])
}

model GameProgress {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  game      Game     @relation(fields: [gameId], references: [id])
  gameId    String
  score     Int
  duration  Int
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TutorSession {
  id        String         @id @default(cuid())
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String         @unique // one active session per student
  messages  TutorMessage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([studentId])
}

model TutorMessage {
  id        String       @id @default(cuid())
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  sender    String       // "user" | "kibo"
  text      String       @db.Text
  createdAt DateTime     @default(now())

  @@index([sessionId])
}

model LearningModule {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  category  String
  data      Json     // Full AI-generated module JSON
  createdAt DateTime @default(now())

  @@unique([studentId, category])
  @@index([studentId])
}
